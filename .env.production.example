# Variáveis da stack de produção (definir no Portainer, não commitar valores reais).
#
# Banco de PRODUÇÃO: mindmap (sem prefixo). Em dev/local você conecta num banco
# separado via túnel SSH — esse não é configurado aqui.
# host=localhost porque o Postgres da VPS só escuta em localhost; a api roda em
# network_mode host, então compartilha esse localhost. sslmode=disable porque
# esse Postgres não tem SSL configurado. Senha com @ precisa virar %40.
DATABASE_URL=postgresql://USER:SENHA@localhost:5432/mindmap?sslmode=disable

# Porta do host onde o nginx (SPA + proxy /api) fica exposto. Acesso: http://72.60.1.97:<WEB_PORT>
WEB_PORT=8080

# Reset de senha por e-mail. Definir no Portainer (não commitar valores reais).
# APP_URL é a base do link enviado — deve apontar pro app público.
# Sem SMTP_HOST o envio degrada pro console (o reset "funciona" mas o link só
# aparece no log da api). Para envio real, usar SMTP de uma mailbox existente
# (ex.: Gmail com app password).
APP_URL=http://72.60.1.97:8080
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=voce@gmail.com
# SMTP_PASS=app-password-do-gmail
# SMTP_FROM=voce@gmail.com
